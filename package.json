{
  "name": "@louisdevzz/dsh-client-math-input",
  "description": "dsh composer plugin: a MathLive visual editor popup that inserts LaTeX into the draft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/client/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "mathlive": "^0.110.0",
    "mathml-to-latex": "^1.8.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
